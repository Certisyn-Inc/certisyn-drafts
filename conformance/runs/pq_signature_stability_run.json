    },
    {
      "leg": "ML-DSA-65 hedged",
      "alg": "FIPS 204, default",
      "verify": "200/200",
      "sig_len_bytes": 3309,
      "distinct_signing_input_digests": 1,
      "distinct_entry_digests": 200
